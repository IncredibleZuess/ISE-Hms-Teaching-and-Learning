# Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=nwu_hms
MYSQL_PORT=3306

# JWT Authentication
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Application
PORT=3000
NODE_ENV=development

# Security & Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=15
MAX_FILE_SIZE=52428800

# MinIO Object Storage (on-premises)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=student-videos
MINIO_BUCKET_EXAMPLES=example-videos
MINIO_BUCKET_VOICE_NOTES=voice-notes

# Email Service (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/hms-app.log
